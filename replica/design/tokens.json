{
  "_about": "Tokens for the personal ASCII converter. Roles measured from the original's layout (dark editor, light primary button, muted labels); values are our own palette.",
  "color": {
    "bg": "#0f1113",
    "surface": "#171a1d",
    "surface-2": "#1f2327",
    "border": "#2a2f34",
    "border-input": "#5f6870",
    "text": "#e8ebe9",
    "text-muted": "#9aa39f",
    "accent": "#5fe3a1",
    "on-accent": "#0b1a12",
    "danger": "#ff6b6b",
    "success": "#5fe3a1"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
    ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-2"],
    ["on-accent", "accent"], ["accent", "bg"], ["accent", "surface"],
    ["danger", "surface"], ["border-input", "surface", "ui"], ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 14, "weight": 500},
    "sm": {"size": 12, "line": 16, "weight": 400},
    "base": {"size": 14, "line": 20, "weight": 400},
    "lg": {"size": 16, "line": 22, "weight": 600}
  },
  "space": [0, 4, 8, 12, 16, 24, 32],
  "radius": {"sm": 4, "md": 6, "lg": 10, "pill": 999},
  "shadow": {"pop": "0 16px 40px rgba(0,0,0,.5)"},
  "motion": {"fast": "100ms", "base": "180ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {"header": 48, "sidebar": 320, "presetStrip": 132, "downloadBar": 64, "breakpoint": 900}
}
