# Written by `npm run passphrase` (or start.cmd on first run). Never commit .env.
GATE_PASSPHRASE=
# 32+ random characters; regenerated each time you set a passphrase
GATE_SECRET=
# Optional: 0.0.0.0 to reach Inkgrid from other devices on your network (default 127.0.0.1 = this PC only)
# HOST=127.0.0.1
# PORT=4173
